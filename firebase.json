{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "ui": {
      "enabled": true,
      "port": 4005
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "runtime": "nodejs24",
      "predeploy": [
        "npm run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        ".github",
        ".ai-context",
        "firestore",
        "scripts",
        "docs",
        "src",
        "*.log",
        ".env",
        ".env.local",
        "firestore.rules",
        "firestore.indexes.json"
      ]
    }
  ]
}
